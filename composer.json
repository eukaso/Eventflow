{
  "name": "eventflow/eventflow",
  "description": "EventFlow Event Management Platform",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "autoload": {
    "psr-4": {
      "EventFlow\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EventFlow\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "scripts": {
    "test": [
      "@test:syntax",
      "@test:unit",
      "@test:integration"
    ],
    "test:syntax": "@php tests/bin/lint.php",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration"
  }
}
